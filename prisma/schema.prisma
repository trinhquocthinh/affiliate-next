// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────
// Auth & Users
// ──────────────────────────────────────────────────────────────

enum Role {
  BUYER
  AFFILIATE
  AFFILIATE_MASTER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
  DELETED
}

model User {
  id                       String     @id @default(cuid())
  email                    String     @unique
  passwordHash             String
  displayName              String?
  role                     Role       @default(BUYER)
  status                   UserStatus @default(PENDING)
  rejectReason             String?
  loginAttempts            Int        @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  passwordChangedAt        DateTime?
  discordId                String?    @unique
  columnPreferences        Json?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  createdRequests     Request[]  @relation("CreatedBy")
  closedRequests      Request[]  @relation("ClosedBy")
  ownedRequests       Request[]  @relation("AffiliateOwner")
  updatedRequests     Request[]  @relation("LastUpdatedBy")
  auditLogs           AuditLog[] @relation("Actor")
  targetedAuditLogs   AuditLog[] @relation("AuditTarget")
  importedRuns        ReconciliationRun[] @relation("ImportedBy")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────
// Business Domain
// ──────────────────────────────────────────────────────────────

enum Platform {
  SHOPEE
  TIKTOK
  OTHER
}

enum RequestStatus {
  NEW
  FILLED
  CLOSED
}

enum CloseReason {
  BOUGHT
  NOT_BUYING
  INVALID
  STALE
  OTHER
}

enum AuditAction {
  CREATE_REQUEST
  FILL_AFFILIATE_LINK
  CLAIM_REQUEST
  UNCLAIM_REQUEST
  SAVE_NOTE
  CLOSE_REQUEST
  BULK_CLOSE
  AUTH_DENIED
  ACTION_ERROR
  UPDATE_CONFIG
  UPDATE_USER
  REGISTER_PENDING
  APPROVE_USER
  REJECT_USER
  DELETE_USER
  REOPEN_USER
  EDIT_ORDER_ID
  EDIT_ORDER_AMOUNT
  OVERRIDE_CLAIM
  ANONYMIZE_USER
}

model Request {
  id               String        @id // REQ-YYYYMMDD-NNNN format
  createdAt        DateTime      @default(now())
  createdById      String
  createdBy        User          @relation("CreatedBy", fields: [createdById], references: [id])
  requesterName    String?
  requesterContact String?
  platform         Platform
  productUrlRaw    String
  productUrlNorm   String        // Normalized URL for duplicate detection
  productName      String?
  affiliateLink    String?
  filledAt         DateTime?
  status           RequestStatus @default(NEW)
  closeReason      CloseReason?
  closeNote        String?
  orderId          String?
  orderAmount      Decimal?      @db.Decimal(12, 2) // BR-015
  closedAt         DateTime?
  closedById       String?
  closedBy         User?         @relation("ClosedBy", fields: [closedById], references: [id])
  affiliateOwnerId String?
  affiliateOwner   User?         @relation("AffiliateOwner", fields: [affiliateOwnerId], references: [id])
  notes              String?
  buyerNote          String?
  subIdStamped       Boolean       @default(false) // SPEC-012, BR-061
  productItemId      String?       // BR-064 — khoá ghép phụ
  orderIdWarning     Boolean       @default(false) // SPEC-004
  lastUpdatedAt      DateTime      @updatedAt
  lastUpdatedById    String?
  lastUpdatedBy      User?         @relation("LastUpdatedBy", fields: [lastUpdatedById], references: [id])
  duplicateOfId      String?
  duplicateOf        Request?      @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicates         Request[]     @relation("Duplicates")
  discordNotifiedAt  DateTime?
  discordMessageId   String?
  sourceChannel      String        @default("website") // E7-S2: discord/website

  auditLogs          AuditLog[]
  reconciliationRows ReconciliationRow[] @relation("MatchedRequest")

  @@index([status])
  @@index([status, createdAt])
  @@index([createdById])
  @@index([affiliateOwnerId])
  @@index([productUrlNorm, createdAt])
  @@index([createdAt])
  @@index([productItemId])
}

model AuditLog {
  id           String      @id @default(cuid())
  timestamp    DateTime    @default(now())
  requestId    String?
  request      Request?    @relation(fields: [requestId], references: [id])
  actorId      String?
  actor        User?       @relation("Actor", fields: [actorId], references: [id])
  targetUserId String?
  targetUser   User?       @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       AuditAction
  oldValue     Json?
  newValue     Json?
  source       String?     // buyer_ui, affiliate_ui, admin
  remark       String?

  @@index([requestId])
  @@index([actorId])
  @@index([targetUserId])
  @@index([timestamp])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// ──────────────────────────────────────────────────────────────
// Reconciliation
// ──────────────────────────────────────────────────────────────

enum MatchMethod {
  SUB_ID
  ORDER_ITEM
  NONE
}

model ReconciliationRun {
  id           String              @id @default(cuid())
  platform     Platform
  fileName     String
  importedById String
  importedBy   User                @relation("ImportedBy", fields: [importedById], references: [id])
  rowCount     Int
  matchedCount Int
  importedAt   DateTime            @default(now())
  rows         ReconciliationRow[]

  @@index([importedById])
  @@index([importedAt])
}

model ReconciliationRow {
  id              String            @id @default(cuid())
  runId           String
  run             ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orderId         String
  itemId          String
  itemName        String
  orderedAt       DateTime
  orderStatus     String
  affiliateStatus String
  price           Decimal           @db.Decimal(12, 2)
  orderValue      Decimal           @db.Decimal(12, 2)
  netCommission   Decimal           @db.Decimal(12, 2)
  subId1          String?
  matchedRequestId String?
  matchedRequest  Request?          @relation("MatchedRequest", fields: [matchedRequestId], references: [id], onDelete: SetNull)
  matchMethod     MatchMethod       @default(NONE)

  @@index([runId])
  @@index([orderId])
  @@index([matchedRequestId])
  @@index([subId1])
}

